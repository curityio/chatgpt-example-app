<config xmlns="http://tail-f.com/ns/config/1.0">
  <profiles xmlns="https://curity.se/ns/conf/base">
    <profile>
      <id>authentication-service</id>
      <type xmlns:auth="https://curity.se/ns/conf/profile/authentication">auth:authentication-service</type>
      <settings>
        <authentication-service xmlns="https://curity.se/ns/conf/profile/authentication">
          <authenticators>
            <authenticator>
              <id>access-token</id>
              <access-token xmlns="https://curity.se/ns/ext-conf/access-token">
                <key-verification>
                  <id>default-signature-verification-key</id>
                </key-verification>
                <allowed-oauth-client-ids>mcp-server-haapi</allowed-oauth-client-ids>
                <required-audience>$EXTERNAL_BASE_URL/</required-audience>
                <required-issuer>$EXTERNAL_BASE_URL/oauth/v2/oauth-anonymous</required-issuer>
                <required-scopes>portfolio</required-scopes>
              </access-token>
            </authenticator>
          </authenticators>
        </authentication-service>
      </settings>
    </profile>
    <profile>
      <id>token-service</id>
      <type xmlns:as="https://curity.se/ns/conf/profile/oauth">as:oauth-service</type>
      <expose-detailed-error-messages/>
      <settings>
        <authorization-server xmlns="https://curity.se/ns/conf/profile/oauth">
          <scopes>
            <default-scope-claim>personal_number</default-scope-claim>
          </scopes>
          <claims>
            <claim>
              <name>personal_number</name>
              <value-provided-by>consentor-claims-provider</value-provided-by>
              <transformation>
                <input-attribute-names>personalNumber</input-attribute-names>
                <value-transformation-procedure>ZnVuY3Rpb24gdHJhbnNmb3JtKGF0dHJpYnV0ZXMpIHsKICByZXR1cm4gYXR0cmlidXRlcy5wZXJzb25hbE51bWJlcjsKfQ==</value-transformation-procedure>
              </transformation>
            </claim>
            <claims-value-provider>
              <id>consentor-claims-provider</id>
              <consent-claims-provider xmlns="https://curity.se/ns/ext-conf/consent-claims-provider"/>
            </claims-value-provider>
            <claims-mappers>
              <claims-mapper>
                <id>default</id>
                <access_token>
                  <claim>personal_number</claim>
                </access_token>
              </claims-mapper>
            </claims-mappers>
          </claims>
          <consentors>
            <consentor>
              <id>bankid-consentor</id>
              <signing-consentor>
                <text-to-display-procedure></text-to-display-procedure>
                <webservice>
                  <hostname>$PORTFOLIO_API_HOST</hostname>
                  <port>8080</port>
                  <context>/api/transactions</context>
                  <http-client>portfolio-api-client</http-client>
                </webservice>
                <bankid-signing-consentor xmlns="https://curity.se/ns/ext-conf/bankid-signing-consentor">
                  <http-client>
                    <id>bankid-client</id>
                  </http-client>
                  <allowed-bankid-types>any</allowed-bankid-types>
                  <mode>test</mode>
                </bankid-signing-consentor>
              </signing-consentor>
            </consentor>
          </consentors>
          <client-store>
            <config-backed>
              <client>
                <id>consent-details-client</id>
                <description>The authorization server uses this client to call the portfolio API and get consent details for the transaction ID in the prefix scope</description>
                <secret>$5$/MHdcosAB4QGv3OL$5qcgscdBc.5IAGOYlEK/bvy.NRb54qbf574XHJMXI66</secret>
                <scope>portfolio</scope>
                <audience>https://api.demo.example</audience>
                <capabilities>
                  <client-credentials/>
                </capabilities>
              </client>
              <client>
                <id>mcp-server-haapi</id>
                <description>The MCP server acts as a HAAPI client to run a backend API-driven step-up authentication flow</description>
                <secret>§5§8LfFRmKklSw/pcbm§RztPpt5FzhrA4a8NwJB8qjijWHa./MJCqwE7GcdIxt8</secret>
                <redirect-uris>haapi:/callback</redirect-uris>
                <user-consent>
                  <only-consentors>true</only-consentors>
                  <consentors>
                    <consentor>bankid-consentor</consentor>
                  </consentors>
                </user-consent>
                <scope>portfolio</scope>
                <scope>transaction</scope>
                <audience>$EXTERNAL_BASE_URL/</audience>
                <user-authentication>
                  <allowed-authenticators>access-token</allowed-authenticators>
                </user-authentication>
                <capabilities>
                  <code>
                  </code>
                  <haapi>
                    <allow-without-attestation>true</allow-without-attestation>
                    <use-legacy-dpop>true</use-legacy-dpop>
                  </haapi>
                </capabilities>
                <validate-port-on-loopback-interfaces>true</validate-port-on-loopback-interfaces>
              </client>
            </config-backed>
          </client-store>
        </authorization-server>
      </settings>
    </profile>
  </profiles>
  <facilities xmlns="https://curity.se/ns/conf/base">
    <http>
      <client>
        <id>bankid-client</id>
        <connection-pool>
        </connection-pool>
        <tls>
          <use-truststore>true</use-truststore>
          <client-keystore>bankid-test-environement</client-keystore>
        </tls>
      </client>
      <client>
        <id>portfolio-api-client</id>
        <scheme>http</scheme>
        <oauth-credentials>
          <client-id>consent-details-client</client-id>
