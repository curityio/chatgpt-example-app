{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["api-server/src/**/*.ts", "mcp-server/src/**/*.ts", "web/src/**/*.ts"],
  "exclude": ["node_modules"]
}
