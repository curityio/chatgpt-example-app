{
  "name": "mcp-portfolio-server",
  "version": "1.0.0",
  "description": "An MCP server that runs a HAAPI flow to implement step-up authorization",
  "main": "src/index.ts",
  "author": "Curity AB",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
      "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env --import=tsx ./src/index.ts",
    "build": "rm -rf dist/mcp && mkdir -p dist/mcp && tsc",
    "haapi": "node --env-file=.env --import=tsx --watch ./src/testHaapiFlow.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "dpop": "^2.1.1",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "morgan": "^1.10.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
