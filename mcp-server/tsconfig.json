{
    "compilerOptions": {
      "strict": true,
      "target": "ES2024",
      "lib": ["ES2024"],
      "module": "Node18",
      "moduleResolution": "Node16",
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "outDir": "dist/mcp"
    },
    "include": [
      "./src"
    ],
    "exclude": [
      "node_modules"
    ]
}